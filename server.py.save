aaaaaaaaaaaaaaafrom urllib.request import Request, urlopenPORT = 8000


class LibreriaHandler(SimpleHTTPRequestHandler):

    def do_GET(self):
        parsed = urlparse(self.path)

        # Ricerca copertine
        if parsed.path == "/api/copertine":
            params = parse_qs(parsed.query)
            titolo = params.get("titolo", [""])[0].strip()

            if not titolo:
                self.invia_json(
                    {"errore": "Scrivi il titolo del libro."},
                    400
                )
                return

            try:
                google_url = (
                    "https://www.googleapis.com/books/v1/volumes"
                    "?q=" + self.codifica(titolo) +
                    "&maxResults=10"
                )

                richiesta = Request(
                    google_url,
                    headers={"User-Agent": "Mozilla/5.0"}
                )

                with urlopen(richiesta, timeout=15) as risposta:
                    dati = json.loads(
                        risposta.read().decode("utf-8")
                    )

                risultati = []

                for item in dati.get("items", []):
                    info = item.get("volumeInfo", {})
                    immagini = info.get("imageLinks", {})

                    copertina = (
                        immagini.get("extraLarge")
                        or immagini.get("large")
                        or immagini.get("medium")
                        or immagini.get("small")
                        or immagini.get("thumbnail")
                        or immagini.get("smallThumbnail")
                    )

                    if copertina:
                        copertina = copertina.replace(
                            "http://", "https://"
                        )

                        risultati.append({
                            "titolo": info.get(
                                "title",
                                "Senza titolo"
                            ),
                            "autori": info.get(
                                "authors",
                                []
                            ),
                            "copertina": copertina
                        })

                self.invia_json({
                    "risultati": risultati[:5]
                })

            except (HTTPError, URLError, TimeoutError) as errore:
                self.invia_json({
                    "errore": "Errore durante la ricerca: "
                              + str(errore)
                }, 500)

            except Exception as errore:
                self.invia_json({
                    "errore": "Errore: " + str(errore)
                }, 500)

            return

        # Tutti gli altri file HTML, immagini, CSS ecc.
        super().do_GET()

    def codifica(self, testo):
        from urllib.parse import quote
        return quote(testo)

    def invia_json(self, dati, codice=200):
        contenuto = json.dumps(
            dati,
            ensure_ascii=False
        ).encode("utf-8")

        self.send_response(codice)
        self.send_header(
            "Content-Type",
            "application/json; charset=utf-8"
        )
        self.send_header(
            "Content-Length",
            str(len(contenuto))
        )
        self.end_headers()
        self.wfile.write(contenuto)


server = ThreadingHTTPServer(
    ("0.0.0.0", PORT),
    LibreriaHandler
)

print("📚 Martina's Virtual Library")
print("Server avviato!")
print("Apri: http://localhost:8000")
print("Per fermarlo premi Ctrl+C")

try:
    server.serve_forever()
except KeyboardInterrupt:
    print("\nServer chiuso.")
    server.server_close()
